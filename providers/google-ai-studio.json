{
  "schemaVersion": "1.0",
  "id": "google-ai-studio",
  "name": "Google AI Studio (Gemini OpenAI API)",
  "category": "official-api",
  "packageType": "official-json",
  "verified": true,
  "publishedAt": "2026-11-17",
  "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "prefix": "Bearer "
  },
